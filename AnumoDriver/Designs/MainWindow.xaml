<Window
    x:Class="AnumoDriver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:AnumoDriver"
    mc:Ignorable="d"
    Title="CENTRAL DOGMA"
    Width="327"
    Height="184"
    WindowStartupLocation="CenterScreen"
    Loaded="Window_Loaded"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
>
    <Window.Resources>
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF868383"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse
                                Fill="{TemplateBinding Background}"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="{TemplateBinding BorderThickness}"
                            />
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#808080"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF868383"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse
                                Fill="{TemplateBinding Background}"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="{TemplateBinding BorderThickness}"
                            />
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Trigger 1: Highlight on Mouse Over -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#808080" />
                            </Trigger>

                            <!-- Trigger 2: Stay highlighted if checked (toggled on) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid
        x:Name="Background"
        MouseLeftButtonDown="Background_MouseLeftButtonDown"
        HorizontalAlignment="Center"
        Width="327"
    >

        <Grid.RowDefinitions>
            <RowDefinition Height="201"/>
        </Grid.RowDefinitions>

        <Rectangle 
            Grid.Row="0"
            RadiusX="16"
            RadiusY="16"
            Margin="0,0,0,17" HorizontalAlignment="Left" Width="327"
        >
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.5">
                    <GradientStop Color="#FFFFF4FB" Offset="0.0"/>
                    <GradientStop Color="#FFFFF4FB" Offset="0.5"/>
                    <GradientStop Color="#FFFF70CA" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--Buttons-->

        <Rectangle
            Grid.Row="0" 
            RadiusX="16"
            RadiusY="16"
            Margin="232,5,0,109" HorizontalAlignment="Left" Width="88"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>
        
        <Button
            x:Name="CloseButton" 
            Style="{StaticResource RoundButtonStyle}"
            Content="✕"
            Click="CloseButton_Click"
            ToolTip="Close application"
            Cursor="Hand"
            Margin="278,14,0,155"
            HorizontalAlignment="Left"
            Width="32"
        />
        
        <Button
            x:Name="SetupButton" 
            Style="{StaticResource RoundButtonStyle}"
            Content="🅰"
            Click="SetupButton_Click"
            ToolTip="Open key setup window"
            Margin="278,51,0,118"
            Cursor="Hand"
            HorizontalAlignment="Left"
            Width="32"
        />

        <ToggleButton
            x:Name="PinToggleButton" 
            Style="{StaticResource RoundToggleButtonStyle}"
            Content="📌"
            Click="PinToggleButton_Click"
            ToolTip="Pin this window so it wont be moveable"
            Margin="242,14,0,155"
            Cursor="Hand"
            HorizontalAlignment="Left"
            Width="32"
        />

        <ToggleButton
            x:Name="TopMostToggleButton" 
            Style="{StaticResource RoundToggleButtonStyle}"
            Content="🧷"
            Click="TopMostToggleButton_Click"
            ToolTip="Make this window always appear on top"
            Margin="242,51,0,118"
            Cursor="Hand"
            HorizontalAlignment="Left"
            Width="32"
        />

        <!--Name and icon of focusing app-->
        <Rectangle Grid.Row="0" 
            RadiusX="16"
            RadiusY="16" Margin="5,5,0,127" HorizontalAlignment="Left" Width="219">
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>

        <ComboBox
            x:Name="PortComboBox"
            BorderBrush="#FF868383"
            Margin="17,18,0,0"
            Height="24"
            Width="63"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Cursor="Hand"
            DropDownOpened="PortComboBox_DropDownOpened"
        />
        <Button
            x:Name="ConnectButton"
            Content="Connect"
            Background="#FF868383"
            Foreground="White"
            Click="ConnectButton_Click"
            ToolTip="Connect to selected port"
            Margin="85,18,0,0"
            Cursor="Hand"
            Height="24"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Width="127"
        />
        <TextBlock
            x:Name="DeviceNameText" 
            Text="No device" 
            Foreground="White" 
            FontSize="12" 
            VerticalAlignment="Top"
            Margin="17,47,0,0"
            HorizontalAlignment="Left"
            Width="195"
        />

        <!--Name and icon of focusing app-->
        <Rectangle Grid.Row="0" 
            RadiusX="20"
            RadiusY="20"
            Margin="5,82,0,76"
            HorizontalAlignment="Left"
            Width="219"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel
            Orientation="Horizontal"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="17,92,0,0" Width="195"
        >
            <Image
                x:Name="AppIcon"
                Width="24"
                Height="24"
            />
            <Rectangle
                Width="1"
                Margin="5,5,5,5"
            >

                <Rectangle.Fill>
                    <SolidColorBrush Color="#FF989898" Opacity="0.75"/>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock
                x:Name="AppNameText" 
                Text="No app focused" 
                Foreground="White" 
                FontSize="12" 
                FontWeight="Bold" 
                VerticalAlignment="Center"
            />
        </StackPanel>

        <!--Layer number-->
        <Rectangle Grid.Row="0" 
            RadiusX="20"
            RadiusY="20" Margin="5,133,0,24" HorizontalAlignment="Left" Width="219">
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock
            Text="Layer:" 
            Foreground="White" 
            FontSize="12" 
            FontWeight="Bold"
            Margin="22,147,0,34" HorizontalAlignment="Left" Width="39"
        />
        <TextBlock
            x:Name="LayerNumberText"
            Foreground="White" 
            FontSize="12" 
            FontWeight="Bold"
            Margin="61,147,0,34" HorizontalAlignment="Left" Width="151"
        />

    </Grid>
</Window>
