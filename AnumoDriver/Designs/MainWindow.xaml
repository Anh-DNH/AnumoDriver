<Window x:Class="AnumoDriver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnumoDriver"
        mc:Ignorable="d"
        Title="CENTRAL DOGMA"
        Width="360"
        Height="201"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        >

    <Window.Resources>
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF868383"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#808080"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="109"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle 
            Grid.Row="0"
            RadiusX="16"
            RadiusY="16" Grid.RowSpan="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.5">
                    <GradientStop Color="#F0EB36" Offset="0.0"/>
                    <GradientStop Color="#73C269" Offset="0.5"/>
                    <GradientStop Color="#1E91A5" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--Title Bar-->
        <Grid x:Name="TitleBar"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              Cursor="SizeAll"
              Margin="5,5,5,5">

            <Rectangle Grid.Row="0" 
                       RadiusX="10"
                       RadiusY="10">
                <Rectangle.Fill>
                    <SolidColorBrush Color="#000000" Opacity="0.75"/>
                </Rectangle.Fill>
            </Rectangle>

            <!--Name and icon of focusing app-->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,65,0,0">
                <Image x:Name="AppIcon" Width="20" Height="20" VerticalAlignment="Center" Margin="5,0,5,0"/>
                <TextBlock x:Name="AppNameText" 
                        Text="No app focused" 
                        Foreground="White" 
                        FontSize="12" 
                        FontWeight="Bold" 
                        VerticalAlignment="Center" Margin="5,0,5,0"/>
                <Separator Width="1" Background="#FF868383" Margin="5,0,5,0"/>
            </StackPanel>

            <!--Port selection and connect-->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0"/>

            <!--Buttons-->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,10,0">

                <Button x:Name="SetupButton" 
                    Style="{StaticResource RoundButtonStyle}"
                    Content="🅰"
                    Click="SetupButton_Click"
                    ToolTip="Open setup window"
                    Margin="0,0,10,0" Cursor="Hand"/>

                <Button x:Name="PinButton" 
                    Style="{StaticResource RoundButtonStyle}"
                    Content="📌"
                    Click="PinButton_Click"
                    ToolTip="Toggle window pin"
                    Margin="0,0,10,0" Cursor="Hand"/>

                <Button x:Name="CloseButton" 
                    Style="{StaticResource RoundButtonStyle}"
                    Content="✕"
                    Click="CloseButton_Click"
                    ToolTip="Close application" Cursor="Hand"/>

            </StackPanel>
            <ComboBox x:Name="PortComboBox"
                        BorderBrush="#FF868383"
                        Margin="10,10,0,0" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="80"
                        />
            <Button x:Name="ConnectButton" 
                    Content="Connect"
                    Background="#FF868383"
                    Foreground="White"
                    Click="ConnectButton_Click"
                    ToolTip="Connect to selected port"
                    Margin="102,10,0,0"
                    Cursor="Hand" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="70"/>
            <TextBlock x:Name="DeviceNameText" 
                        Text="No device" 
                        Foreground="White" 
                        FontSize="12" 
                        VerticalAlignment="Top" Margin="10,39,0,0" HorizontalAlignment="Left" Width="184"/>
        </Grid>

        <TextBox x:Name="InputDataTextBox" Grid.Row="1" Margin="10,6,10,60" IsReadOnly="True"/>
        <TextBox Grid.Row="1" Margin="10,40,10,9"/>
    </Grid>
</Window>
