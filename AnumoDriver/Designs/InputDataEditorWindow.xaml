<Window 
    x:Class="AnumoDriver.Designs.InputDataEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:AnumoDriver.Designs"
    xmlns:c="clr-namespace:AnumoDriver.Utilities"
    mc:Ignorable="d"
    Title="InputDataEditorWindow"
    Width="789"
    Height="476"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen"
    AllowsTransparency="True"
    Background="Transparent" Loaded="Window_Loaded"
>
    <Window.Resources>
        <c:EnumToStringConverter x:Key="EnumToStringConverter"/>
    </Window.Resources>
    <Grid>

        <Grid.OpacityMask>
            <VisualBrush Visual="{Binding ElementName=Border1}" />
        </Grid.OpacityMask>

        <Border
            x:Name="Border1"
            CornerRadius="16"
            Background="White"
            Grid.ColumnSpan="2"
            Grid.RowSpan="4"
        >
        </Border>

        <Rectangle
            Grid.ColumnSpan="2"
            Grid.RowSpan="4"
        >
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.1,1">
                    <GradientStop Color="#FFFFF4FB" Offset="0.0"/>
                    <GradientStop Color="#FFFFF4FB" Offset="0.6"/>
                    <GradientStop Color="#FFFF70CA" Offset="1.7"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        
        <!--Input name-->
        <Rectangle
            RadiusX="16"
            RadiusY="16"
            Width="769"
            Height="93"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" Canvas.Left="11" Canvas.Top="12" Margin="0,10,0,0"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label
            Content="INPUT NAME"
            Foreground="White"
            Canvas.Left="20"
            Canvas.Top="22"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="22,22,0,0"
        />
        <TextBox
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
            VerticalAlignment="Top"
            Width="737"
            Height="40"
            FontSize="28" Canvas.Left="24" Canvas.Top="48" Margin="0,46,0,0"
        />
        <!--Input name-->
        <Rectangle 
            RadiusX="16"
            RadiusY="16"
            Height="311"
            Width="217"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="10,116,0,0"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label
            Content="SIGNAL"
            Foreground="White"
            Canvas.Left="23"
            Canvas.Top="122"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" Margin="20,123,0,0"
        />
        <ComboBox
            x:Name="InputSignalComboBox"
            BorderBrush="Black"
            Foreground="Black" 
            Background="White"
            Canvas.Left="27"
            Canvas.Top="148"
            Width="188"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="24,147,0,0"
            SelectionChanged="InputSignalComboBox_SelectionChanged"
        />
        <ContentControl
            x:Name="InputSignalContentControl"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
            Width="188"
            Height="234"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="24,174,0,0"
        />
        <!--Action name-->
        <Rectangle 
            RadiusX="16"
            RadiusY="16" Height="310" Canvas.Left="235" Canvas.Top="115" Width="539" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,117,0,0"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label
            Content="ACTION"
            Foreground="White"
            Canvas.Left="247"
            Canvas.Top="122"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" Margin="253,123,0,0"
        />
        <ComboBox x:Name="InputActionComboBox"
            BorderBrush="White"
            Foreground="Black" 
            Background="White"
            Canvas.Left="251"
            Canvas.Top="148"
            Width="254"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="257,147,0,0"
            SelectionChanged="InputActionComboBox_SelectionChanged"
        />
        <ContentControl
            x:Name="InputActionContentControl"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
            Width="508"
            Height="234"
            Canvas.Left="251"
            Canvas.Top="171"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="257,174,0,0"
        />
        <Button
            x:Name="CloseButton" 
            Content="Close"
            Background="#FF868383"
            Foreground="White"
            
            ToolTip="Connect to selected port"
            Margin="13,439,708,0"
            Cursor="Hand" Height="24"
            VerticalAlignment="Top"
            Click="CloseButton_Click"
        />
    </Grid>
</Window>
