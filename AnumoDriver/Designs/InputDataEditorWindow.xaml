<Window x:Class="AnumoDriver.Designs.InputDataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnumoDriver.Designs"
        xmlns:c="clr-namespace:AnumoDriver.Utilities"
        mc:Ignorable="d"
        Title="InputDataEditorWindow"
        Width="800"
        Height="450"
>
    <Window.Resources>
        <c:EnumToStringConverter x:Key="EnumToString"/>
    </Window.Resources>
    <Grid>
        <!--Input name-->
        <Rectangle
            RadiusX="16"
            RadiusY="16" Margin="10,10,10,336"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label
            Content="INPUT NAME"
            Foreground="White"
            Margin="24,15,695,394"
        />
        <TextBox
            HorizontalAlignment="Center"
            Margin="0,40,0,0"
            TextWrapping="Wrap"
            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
            VerticalAlignment="Top"
            Width="751"
            Height="40"
            FontSize="28"
        />
        <!--Input name-->
        <Rectangle 
            RadiusX="16"
            RadiusY="16" Margin="11,108,469,11"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label
            Content="SIGNAL"
            Foreground="White"
            Margin="25,116,723,293"
        />
        <ComboBox x:Name="InputSignalComboBox"
            BorderBrush="Black"
            Foreground="Black" 
            Background="White"
            Margin="25,141,483,271"
            ItemsSource="{Binding SignalTypes, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
            SelectedItem="{Binding SignalType, Converter={StaticResource EnumToString}, UpdateSourceTrigger=PropertyChanged}"
        />
        <ContentControl
            x:Name="SignalContentControl"
            Margin="25,168,484,17"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
        />
        <!--Action name-->
        <Rectangle 
            RadiusX="16"
            RadiusY="16" Margin="346,108,10,11"
        >
            <Rectangle.Fill>
                <SolidColorBrush Color="#000000" Opacity="0.75"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label
            Content="ACTION"
            Foreground="White"
            Margin="360,117,388,293"
        />
        <ComboBox x:Name="InputActionComboBox"
            BorderBrush="White"
            Foreground="Black" 
            Background="White"
            Margin="360,141,24,271"
            ItemsSource="{Binding ActionTypes, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
            SelectedItem="{Binding ActionType, Converter={StaticResource EnumToString}, UpdateSourceTrigger=PropertyChanged}"
        />
        <ContentControl
            x:Name="ActionContentControl" 
            Margin="360,168,24,17"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
        />
    </Grid>
</Window>
