<UserControl 
    x:Class="AnumoDriver.Designs.UserControls.InputAction_WriteText_Uctrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:AnumoDriver.Designs.UserControls"
    mc:Ignorable="d" 
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Width="508"
    Height="234"
>
             
    <Grid>
        <Label
            Foreground="White"
            Content="Text:"
            Margin="0,0,388,208"
        />
        <TextBox 
            x:Name="TextTextBox"
            TextWrapping="Wrap"
            Text="{Binding Text}"
            Margin="0,26,0,0"
        />

    </Grid>
</UserControl>
