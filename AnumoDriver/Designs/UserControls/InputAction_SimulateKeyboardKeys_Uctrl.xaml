        <ScrollViewer
            Margin="0,33,89,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
        >
            <ItemsControl
                x:Name="VirtualKeyItemsControl"
                Tag="{Binding .}"
            >

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        
                        <Grid
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Height="30"
                        >

                            <ComboBox
                                Width="270"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsTextSearchEnabled="True"
                                ItemsSource="{Binding KeyNames}"
                                SelectedIndex="{Binding ComboBoxSelectedIndex}"
                                SelectionChanged="KeyNameComboBox_SelectionChanged"
                            >
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                            <Button
                                Content="↑"
                                Background="#FF868383"
                                Foreground="White"
                                Margin="277,0,0,0"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Click="KeyNameButton_MoveUp_Click"
                            />
                            <Button
                                Content="↓"
                                Background="#FF868383"
                                Foreground="White"
                                Margin="306,0,0,0"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Click="KeyNameButton_MoveDown_Click"
                            />
                            <Button
                                Content="Remove"
                                Background="#FF868383"
                                Foreground="White"
                                Margin="337,0,0,0"
                                Width="58"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Click="KeyNameButton_Remove_Click"
                            />
                        </Grid>
                        
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

        
    </Grid>
</UserControl>
