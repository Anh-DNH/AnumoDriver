<UserControl 
    x:Class="AnumoDriver.Designs.UserControls.InputAction_SimulateKeyboardKeys_Uctrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:AnumoDriver.Designs.UserControls"
    mc:Ignorable="d"
    Width="508"
    Height="234"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Loaded="UserControl_Loaded"
>
    <Grid>

        <TextBox 
            x:Name="MouseScrollDeltaTextBox"
            TextWrapping="Wrap"
            Width="508"
            Height="23"
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"
        />

        <Button
            x:Name="AddButton" 
            Content="Add"
            Background="#FF868383"
            Foreground="White"
            
            ToolTip="Add a new key at the bottom of list"
            Margin="437,33,0,0"
            Cursor="Hand" Height="24"
            VerticalAlignment="Top"
            Click="AddButton_Click"
        />

        <Button
            x:Name="ClearButton" 
            Content="Clear"
            Background="#FF868383"
            Foreground="White"
            
            ToolTip="Clear all keys"
            Margin="437,66,0,0"
            Cursor="Hand" Height="24"
            VerticalAlignment="Top"
            Click="ClearButton_Click"
        />
