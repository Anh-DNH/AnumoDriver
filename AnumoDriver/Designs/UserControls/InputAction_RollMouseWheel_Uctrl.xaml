<UserControl 
    x:Class="AnumoDriver.Designs.UserControls.InputAction_RollMouseWheel_Uctrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:AnumoDriver.Designs.UserControls"
    mc:Ignorable="d"
    Width="120"
    Height="44"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Loaded="UserControl_Loaded"
>
    <Canvas>
        <Label
            Foreground="White"
            Content="Delta:"
            Width="120"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
        />
        <TextBox 
            x:Name="MouseScrollDeltaTextBox"
            TextWrapping="Wrap"
            Canvas.Top="26"
            Width="120"
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"
            TextChanged="MouseScrollDeltaTextBox_TextChanged"
        />
    </Canvas>
</UserControl>
