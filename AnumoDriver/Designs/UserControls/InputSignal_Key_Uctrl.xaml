<UserControl x:Class="AnumoDriver.Designs.UserControls.InputSignal_Key_Uctrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnumoDriver.Designs.UserControls"
             mc:Ignorable="d" Height="121" Width="222">
    <Canvas>
        <ComboBox
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="222" Canvas.Top="26"
        />
        <Label
            Content="Key press type"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="222" Foreground="White"
        />

        <Canvas
            x:Name="ShowWhenTypeEqualMultiple"
        >
            <Label
                Content="Press counts:"
                Width="222" Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Canvas.Top="48"
            />
            <TextBox
                TextWrapping="Wrap"
                Text="2"
                Canvas.Top="74"
                Width="111" HorizontalAlignment="Left" VerticalAlignment="Center"
            />
        </Canvas>

    </Canvas>
</UserControl>
