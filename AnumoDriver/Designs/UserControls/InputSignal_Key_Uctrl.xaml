<UserControl 
    x:Class="AnumoDriver.Designs.UserControls.InputSignal_Key_Uctrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:AnumoDriver.Designs.UserControls"
    mc:Ignorable="d"
    Height="136"
    Width="111"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Loaded="UserControl_Loaded"
>
    <Canvas>
        
        <Label
            Content="Key Code:"
            Width="111" Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
        />
        <TextBox
            x:Name="KeyCodeTextBox"
            TextWrapping="Wrap"
            Canvas.Top="26"
            Width="111"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            TextChanged="KeyCodeTextBox_TextChanged"
        />

        <Label
            Content="Key Press Type:"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="111" Foreground="White" Canvas.Top="44"
        />
        <ComboBox
            x:Name="KeyPressTypeComboBox"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="111" Canvas.Top="70" SelectionChanged="KeyPressTypeComboBox_SelectionChanged"
        />

        <Canvas
            x:Name="ShowWhenTypeEqualMultiple"
            Visibility="Visible"
        >
            <Label
                Content="Click Counts:"
                Width="111" Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Canvas.Top="92"
            />
            <TextBox
                x:Name="ClickCountTextBox"
                TextWrapping="Wrap"
                Canvas.Top="118"
                Width="111"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                TextChanged="ClickCountTextBox_TextChanged"
            />
        </Canvas>

    </Canvas>
</UserControl>
