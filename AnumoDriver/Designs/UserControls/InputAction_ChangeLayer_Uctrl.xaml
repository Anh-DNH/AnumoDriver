<UserControl x:Class="AnumoDriver.Designs.UserControls.InputAction_ChangeLayer_Uctrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnumoDriver.Designs.UserControls"
             mc:Ignorable="d"
             Width="120"
             Height="44"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Loaded="UserControl_Loaded"
>
    <Canvas>
        
        <Label
            Foreground="White"
            Content="Layer:"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="120"
        />
        <TextBox 
            x:Name="LayerIndexTextBox"
            TextWrapping="Wrap"
            Canvas.Top="26"
            Width="120"
            TextChanged="LayerIndexTextBox_TextChanged"
        />

    </Canvas>
</UserControl>
