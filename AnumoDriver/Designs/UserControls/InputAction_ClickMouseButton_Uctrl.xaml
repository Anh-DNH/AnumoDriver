<UserControl x:Class="AnumoDriver.Designs.UserControls.InputAction_ClickMouseButton_Uctrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnumoDriver.Designs.UserControls"
             mc:Ignorable="d" Height="48" Width="120">
    <Canvas>
        <Label
            Foreground="White"
            Content="Button:"
            Width="120"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        />
        <ComboBox
            Canvas.Top="26"
            Width="120"
            ItemsSource="{Binding ButtonName}"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        />
    </Canvas>
</UserControl>
